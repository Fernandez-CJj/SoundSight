rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isVerifiedUser() {
      return request.auth != null
             && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return request.auth != null
             && get(
                  /databases/$(database)/documents/admins/$(request.auth.uid)
                ).data.enabled == true;
    }

    function validMusicSheet(data) {
      return data.title is string
             && data.title.size() > 0
             && data.title.size() <= 80
             && data.pageCount is int
             && data.pageCount <= 20
             && data.files is list
             && (
               (data.type == 'pdf'
                 && data.files.size() == 1
                 && data.pageCount > 0)
               ||
               (data.type == 'images'
                 && data.pageCount > 0
                 && data.files.size() == data.pageCount)
               ||
               (data.type == 'audio'
                 && data.pageCount == 0
                 && data.durationMs is int
                 && data.durationMs > 0
                 && data.durationMs <= 300000
                 && data.files.size() == 1
                 && data.files[0] is map
                 && data.files[0].storagePath is string
                 && data.files[0].sizeBytes is int
                 && data.files[0].sizeBytes > 0
                 && data.files[0].sizeBytes <= 95000000
                 && data.files[0].contentType == 'audio/mpeg')
             );
    }

    function validComposition(data) {
      return data.keys().hasOnly([
               'ownerId',
               'title',
               'key',
               'tempo',
               'beatsPerMeasure',
               'beatUnit',
               'measureCount',
               'notes',
               'creationMethod',
               'recordingSchemaVersion',
               'performanceNotes',
               'performanceDurationUs',
               'pdfStoragePath',
               'musicXmlStoragePath',
               'midiStoragePath',
               'mp3StoragePath',
               'generatedFilesVersion',
               'generationStatus',
               'filesGeneratedAt',
               'createdAt',
               'updatedAt'
             ])
             && data.ownerId is string
             && data.title is string
             && data.title.size() > 0
             && data.title.size() <= 80
             && data.key is string
             && data.key.size() > 0
             && data.key.size() <= 20
             && data.tempo is int
             && data.tempo >= 40
             && data.tempo <= 200
             && data.beatsPerMeasure is int
             && data.beatUnit is int
             && (
               (data.beatUnit == 4
                 && data.beatsPerMeasure >= 2
                 && data.beatsPerMeasure <= 7)
               ||
               (data.beatUnit == 8
                 && (
                   data.beatsPerMeasure == 3
                   || data.beatsPerMeasure == 6
                   || data.beatsPerMeasure == 9
                   || data.beatsPerMeasure == 12
                 ))
             )
             && data.measureCount is int
             && data.measureCount > 0
             && data.measureCount <= 128
             && data.notes is list
             && data.notes.size() <= 256
             && data.creationMethod in ['manual', 'recording']
             && (!('recordingSchemaVersion' in data)
                 || data.recordingSchemaVersion == 1)
             && (!('performanceNotes' in data)
                 || (data.performanceNotes is list
                     && data.performanceNotes.size() > 0
                     && data.performanceNotes.size() <= 256))
             && (!('performanceDurationUs' in data)
                 || (data.performanceDurationUs is int
                     && data.performanceDurationUs > 0
                     && data.performanceDurationUs <= 600000000))
             && (
               !('recordingSchemaVersion' in data)
               || (data.creationMethod == 'recording'
                   && data.recordingSchemaVersion == 1
                   && data.performanceNotes is list
                   && data.performanceNotes.size() > 0
                   && data.performanceDurationUs is int)
             )
             && (!('pdfStoragePath' in data)
                 || data.pdfStoragePath is string)
             && (!('musicXmlStoragePath' in data)
                 || data.musicXmlStoragePath is string)
             && (!('midiStoragePath' in data)
                 || data.midiStoragePath is string)
             && (!('mp3StoragePath' in data)
                 || data.mp3StoragePath is string)
             && (!('generatedFilesVersion' in data)
                 || data.generatedFilesVersion is int)
             && (!('generationStatus' in data)
                 || data.generationStatus in [
                      'pending',
                      'generating',
                      'completed',
                      'failed'
                    ])
             && (!('filesGeneratedAt' in data)
                 || data.filesGeneratedAt is timestamp)
             && data.createdAt is timestamp
             && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      function ownsUser() {
        return isVerifiedUser()
               && request.auth.uid == userId;
      }

      function hasValidLanguageCode(data) {
        return !data.keys().hasAny(['languageCode'])
               || data.languageCode in ['en', 'fil'];
      }

      function skillRank(level) {
        return level == 'advanced'
          ? 3
          : level == 'intermediate'
            ? 2
            : level == 'beginner'
              ? 1
              : 0;
      }

      function validAssessmentSkillLevelUpdate() {
        let attempt = getAfter(
          /databases/$(database)/documents/users/$(userId)/assessment/current
        );
        let previousSkillLevel = resource.data.keys().hasAny(['skillLevel'])
          ? resource.data.skillLevel
          : null;

        return request.resource.data.diff(resource.data)
                 .affectedKeys()
                 .hasOnly([
                   'skillLevel',
                   'updatedAt'
                 ])
               && request.resource.data.updatedAt == request.time
               && attempt.data.userId == userId
               && (
                 (
                   attempt.data.status == 'completed'
                   && attempt.data.currentSection == 'results'
                   && request.resource.data.skillLevel
                      == attempt.data.finalSkillLevel
                   && skillRank(request.resource.data.skillLevel)
                      > skillRank(previousSkillLevel)
                 )
                 ||
                 (
                   attempt.data.status == 'expired'
                   && request.resource.data.skillLevel == 'beginner'
                   && skillRank(previousSkillLevel) == 0
                 )
               );
      }

      function validPracticeLevelUpdate() {
        let previousLevel = resource.data.keys().hasAny(['practiceLevel'])
          ? resource.data.practiceLevel
          : 1;
        let previousExperience = resource.data.keys().hasAny(['experiencePoints'])
          ? resource.data.experiencePoints
          : 0;
        let previousSkillLevel = resource.data.keys().hasAny(['skillLevel'])
          ? resource.data.skillLevel
          : null;
        let expectedSkillLevel = previousLevel == 16
          ? 'advanced'
          : previousLevel == 9 && previousSkillLevel != 'advanced'
            ? 'intermediate'
            : previousSkillLevel;

        return request.resource.data.diff(resource.data)
                 .affectedKeys()
                 .hasAny(['practiceLevel'])
               && request.resource.data.diff(resource.data)
                    .affectedKeys()
                    .hasOnly([
                      'practiceLevel',
                      'skillLevel',
                      'experiencePoints',
                      'updatedAt'
                    ])
               && previousLevel is int
               && previousLevel >= 1
               && previousLevel <= 16
               && previousExperience is int
               && previousExperience >= 0
               && request.resource.data.practiceLevel is int
               && request.resource.data.practiceLevel == previousLevel + 1
               && request.resource.data.experiencePoints is int
               && request.resource.data.experiencePoints
                    == previousExperience + 50
               && (
                 request.resource.data.keys().hasAny(['skillLevel'])
                   ? request.resource.data.skillLevel
                   : null
               ) == expectedSkillLevel
               && request.resource.data.updatedAt == request.time;
      }

      allow create: if ownsUser()
                    && hasValidLanguageCode(request.resource.data)
                    && (
                      !request.resource.data.keys().hasAny(['skillLevel'])
                      || request.resource.data.skillLevel == null
                    )
                    && (
                      !request.resource.data.keys().hasAny(['practiceLevel'])
                      || request.resource.data.practiceLevel == 1
                    )
                    && (
                      !request.resource.data.keys().hasAny(['experiencePoints'])
                      || request.resource.data.experiencePoints == 0
                    );

      allow read: if ownsUser() || isAdmin();

      allow delete: if ownsUser();

      allow update: if ownsUser()
                    && hasValidLanguageCode(request.resource.data)
                    && (
                      !request.resource.data.diff(resource.data)
                        .affectedKeys()
                        .hasAny(['skillLevel', 'practiceLevel'])
                      || validPracticeLevelUpdate()
                      || validAssessmentSkillLevelUpdate()
                    );

      match /achievements/{badgeId} {
        function validEarnedBadge() {
          let data = request.resource.data;
          let profile = getAfter(
            /databases/$(database)/documents/users/$(userId)
          ).data;

          return (
            badgeId == 'first_measure'
            && getAfter(
              /databases/$(database)/documents/users/$(userId)/assessment/current
            ).data.status == 'completed'
          ) || (
            badgeId == 'sheet_collector'
            && 'sourceId' in data
            && data.sourceId is string
            && getAfter(
              /databases/$(database)/documents/users/$(userId)/musicSheets/$(data.sourceId)
            ).data.ownerId == userId
          ) || (
            badgeId == 'first_composer'
            && 'sourceId' in data
            && data.sourceId is string
            && getAfter(
              /databases/$(database)/documents/users/$(userId)/compositions/$(data.sourceId)
            ).data.ownerId == userId
          ) || (
            profile.practiceLevel is int
            && (
              (badgeId == 'middle_c' && profile.practiceLevel > 3)
              || (badgeId == 'first_melody' && profile.practiceLevel > 6)
              || (badgeId == 'growing_musician' && profile.practiceLevel > 9)
              || (badgeId == 'chord_builder' && profile.practiceLevel > 12)
              || (badgeId == 'music_navigator' && profile.practiceLevel > 15)
              || (badgeId == 'soundsight_master' && profile.practiceLevel > 16)
            )
          );
        }

        allow read: if ownsUser() || isAdmin();

        allow create: if ownsUser()
                      && badgeId in [
                        'first_measure',
                        'sheet_collector',
                        'first_composer',
                        'middle_c',
                        'first_melody',
                        'growing_musician',
                        'chord_builder',
                        'music_navigator',
                        'soundsight_master'
                      ]
                      && request.resource.data.keys().hasOnly([
                        'earnedAt',
                        'source',
                        'sourceId'
                      ])
                      && request.resource.data.keys().hasAll([
                        'earnedAt',
                        'source'
                      ])
                      && request.resource.data.earnedAt == request.time
                      && (
                        (
                          request.resource.data.source == 'earned'
                          && validEarnedBadge()
                        )
                        || (
                          request.resource.data.source == 'migration'
                          && getAfter(
                            /databases/$(database)/documents/users/$(userId)
                          ).data.achievementsMigrated == true
                        )
                      );

        allow update, delete: if false;
      }

      match /pianoCalibrations/{calibrationId} {
        allow create, read, update, delete: if isVerifiedUser()
                                            && request.auth.uid == userId;
      }

      match /assessment/{assessmentId} {
        function ownsCurrentAssessment() {
          return isVerifiedUser()
                 && request.auth.uid == userId
                 && assessmentId == 'current';
        }

        function expectedExpiredSkillLevel() {
          let profile = get(
            /databases/$(database)/documents/users/$(userId)
          );
          let skill = profile.data.keys().hasAny(['skillLevel'])
            ? profile.data.skillLevel
            : null;
          return skill in ['beginner', 'intermediate', 'advanced']
            ? skill
            : 'beginner';
        }

        function validQuestionnaireAnswers(answers) {
          return answers is map
                 && answers.keys().hasOnly([
                      'piano_experience',
                      'sheet_music_experience',
                      'learning_method',
                      'primary_goal'
                    ])
                 && answers.keys().hasAll([
                      'piano_experience',
                      'sheet_music_experience',
                      'learning_method',
                      'primary_goal'
                    ])
                 && answers.piano_experience in [
                      'new_to_piano',
                      'under_one_year',
                      'one_to_three_years',
                      'more_than_three_years'
                    ]
                 && answers.sheet_music_experience in [
                      'not_familiar',
                      'basic_familiarity',
                      'moderate_familiarity',
                      'comfortable'
                    ]
                 && answers.learning_method in [
                      'no_formal_learning',
                      'teacher',
                      'self_taught',
                      'mixed_learning'
                    ]
                 && answers.primary_goal in [
                      'learn_notation',
                      'improve_sight_reading',
                      'improve_coordination',
                      'track_progress'
                    ];
        }

        function isSelfReportedBeginner(answers) {
          return answers.piano_experience == 'new_to_piano'
                 || answers.sheet_music_experience == 'not_familiar';
        }

        function validNotationReadingAnswers(answers) {
          return answers is map
                 && answers.keys().hasOnly([
                      'beginner_treble_e4',
                      'beginner_bass_g2',
                      'beginner_treble_c5',
                      'beginner_quarter_note',
                      'beginner_half_note',
                      'beginner_four_four_time',
                      'intermediate_treble_c4',
                      'intermediate_bass_e2',
                      'intermediate_f_sharp',
                      'intermediate_g_major',
                      'intermediate_f_major',
                      'intermediate_third',
                      'advanced_bass_c4',
                      'advanced_six_eight_time',
                      'advanced_d_major',
                      'advanced_perfect_fifth',
                      'advanced_c_major_triad',
                      'advanced_short_passage'
                    ])
                 && answers.keys().hasAll([
                      'beginner_treble_e4',
                      'beginner_bass_g2',
                      'beginner_treble_c5',
                      'beginner_quarter_note',
                      'beginner_half_note',
                      'beginner_four_four_time',
                      'intermediate_treble_c4',
                      'intermediate_bass_e2',
                      'intermediate_f_sharp',
                      'intermediate_g_major',
                      'intermediate_f_major',
                      'intermediate_third',
                      'advanced_bass_c4',
                      'advanced_six_eight_time',
                      'advanced_d_major',
                      'advanced_perfect_fifth',
                      'advanced_c_major_triad',
                      'advanced_short_passage'
                    ])
                 && answers.beginner_treble_e4 in [
                      'c', 'd', 'e', 'f'
                    ]
                 && answers.beginner_bass_g2 in [
                      'e', 'f', 'g', 'a'
                    ]
                 && answers.beginner_treble_c5 in [
                      'a', 'b', 'c', 'd'
                    ]
                 && answers.beginner_quarter_note in [
                      'half_beat', 'one_beat', 'two_beats', 'four_beats'
                    ]
                 && answers.beginner_half_note in [
                      'half_beat', 'one_beat', 'two_beats', 'four_beats'
                    ]
                 && answers.beginner_four_four_time in [
                      'two_quarter_beats',
                      'three_quarter_beats',
                      'four_quarter_beats',
                      'four_eighth_beats'
                    ]
                 && answers.intermediate_treble_c4 in [
                      'b', 'c', 'd', 'e'
                    ]
                 && answers.intermediate_bass_e2 in [
                      'd', 'e', 'f', 'g'
                    ]
                 && answers.intermediate_f_sharp in [
                      'e', 'f', 'f_sharp', 'g_flat'
                    ]
                 && answers.intermediate_g_major in [
                      'c_major', 'g_major', 'd_major', 'f_major'
                    ]
                 && answers.intermediate_f_major in [
                      'c_major', 'g_major', 'd_major', 'f_major'
                    ]
                 && answers.intermediate_third in [
                      'second', 'third', 'fourth', 'fifth'
                    ]
                 && answers.advanced_bass_c4 in [
                      'a', 'b', 'c', 'd'
                    ]
                 && answers.advanced_six_eight_time in [
                      'two_dotted_quarter_beats',
                      'three_quarter_beats',
                      'four_quarter_beats',
                      'six_quarter_beats'
                    ]
                 && answers.advanced_d_major in [
                      'c_major', 'g_major', 'd_major', 'f_major'
                    ]
                 && answers.advanced_perfect_fifth in [
                      'major_third',
                      'perfect_fourth',
                      'perfect_fifth',
                      'major_sixth'
                    ]
                 && answers.advanced_c_major_triad in [
                      'c_major', 'd_minor', 'e_minor', 'f_major'
                    ]
                 && answers.advanced_short_passage in [
                      'two_beats', 'three_beats', 'four_beats', 'five_beats'
                    ];
        }

        function notationPoint(answer, correctAnswer) {
          return answer == correctAnswer ? 1 : 0;
        }

        function validNotationReadingScore(answers, score) {
          return score is map
                 && score.keys().hasOnly([
                      'beginnerCorrect',
                      'intermediateCorrect',
                      'advancedCorrect',
                      'totalCorrect'
                    ])
                 && score.keys().hasAll([
                      'beginnerCorrect',
                      'intermediateCorrect',
                      'advancedCorrect',
                      'totalCorrect'
                    ])
                 && score.beginnerCorrect is int
                 && score.intermediateCorrect is int
                 && score.advancedCorrect is int
                 && score.totalCorrect is int
                 && score.beginnerCorrect
                    == notationPoint(answers.beginner_treble_e4, 'e')
                       + notationPoint(answers.beginner_bass_g2, 'g')
                       + notationPoint(answers.beginner_treble_c5, 'c')
                       + notationPoint(
                           answers.beginner_quarter_note,
                           'one_beat'
                         )
                       + notationPoint(
                           answers.beginner_half_note,
                           'two_beats'
                         )
                       + notationPoint(
                           answers.beginner_four_four_time,
                           'four_quarter_beats'
                         )
                 && score.intermediateCorrect
                    == notationPoint(answers.intermediate_treble_c4, 'c')
                       + notationPoint(answers.intermediate_bass_e2, 'e')
                       + notationPoint(
                           answers.intermediate_f_sharp,
                           'f_sharp'
                         )
                       + notationPoint(
                           answers.intermediate_g_major,
                           'g_major'
                         )
                       + notationPoint(
                           answers.intermediate_f_major,
                           'f_major'
                         )
                       + notationPoint(answers.intermediate_third, 'third')
                 && score.advancedCorrect
                    == notationPoint(answers.advanced_bass_c4, 'c')
                       + notationPoint(
                           answers.advanced_six_eight_time,
                           'two_dotted_quarter_beats'
                         )
                       + notationPoint(
                           answers.advanced_d_major,
                           'd_major'
                         )
                       + notationPoint(
                           answers.advanced_perfect_fifth,
                           'perfect_fifth'
                         )
                       + notationPoint(
                           answers.advanced_c_major_triad,
                           'c_major'
                         )
                       + notationPoint(
                           answers.advanced_short_passage,
                           'four_beats'
                         )
                 && score.totalCorrect
                    == score.beginnerCorrect
                       + score.intermediateCorrect
                       + score.advancedCorrect;
        }

        function validPianoExecutionScore(results, score) {
          return results is map
                 && results.keys().hasOnly([
                      'beginner_middle_c',
                      'beginner_five_finger_pattern',
                      'beginner_c_major_chord',
                      'intermediate_c_major_scale',
                      'intermediate_c_major_arpeggio',
                      'intermediate_chord_progression',
                      'advanced_two_octave_scale',
                      'advanced_chord_inversions',
                      'advanced_parallel_scale'
                    ])
                 && results.keys().hasAll([
                      'beginner_middle_c',
                      'beginner_five_finger_pattern',
                      'beginner_c_major_chord',
                      'intermediate_c_major_scale',
                      'intermediate_c_major_arpeggio',
                      'intermediate_chord_progression',
                      'advanced_two_octave_scale',
                      'advanced_chord_inversions',
                      'advanced_parallel_scale'
                    ])
                 && score is map
                 && score.keys().hasOnly([
                      'beginnerCorrectGroups',
                      'beginnerTotalGroups',
                      'intermediateCorrectGroups',
                      'intermediateTotalGroups',
                      'advancedCorrectGroups',
                      'advancedTotalGroups',
                      'totalCorrectGroups',
                      'totalGroups',
                      'wrongGroups',
                      'missedGroups',
                      'timingMistakes'
                    ])
                 && score.keys().hasAll([
                      'beginnerCorrectGroups',
                      'beginnerTotalGroups',
                      'intermediateCorrectGroups',
                      'intermediateTotalGroups',
                      'advancedCorrectGroups',
                      'advancedTotalGroups',
                      'totalCorrectGroups',
                      'totalGroups',
                      'wrongGroups',
                      'missedGroups',
                      'timingMistakes'
                    ])
                 && score.beginnerCorrectGroups is int
                 && score.beginnerTotalGroups is int
                 && score.intermediateCorrectGroups is int
                 && score.intermediateTotalGroups is int
                 && score.advancedCorrectGroups is int
                 && score.advancedTotalGroups is int
                 && score.totalCorrectGroups is int
                 && score.totalGroups is int
                 && score.wrongGroups is int
                 && score.missedGroups is int
                 && score.timingMistakes is int
                 && score.beginnerTotalGroups == 7
                 && score.intermediateTotalGroups == 19
                 && score.advancedTotalGroups == 27
                 && score.totalGroups == 53
                 && score.beginnerCorrectGroups >= 0
                 && score.beginnerCorrectGroups
                    <= score.beginnerTotalGroups
                 && score.intermediateCorrectGroups >= 0
                 && score.intermediateCorrectGroups
                    <= score.intermediateTotalGroups
                 && score.advancedCorrectGroups >= 0
                 && score.advancedCorrectGroups
                    <= score.advancedTotalGroups
                 && score.totalCorrectGroups
                    == score.beginnerCorrectGroups
                       + score.intermediateCorrectGroups
                       + score.advancedCorrectGroups
                 && score.totalCorrectGroups >= 0
                 && score.totalCorrectGroups <= score.totalGroups
                 && score.wrongGroups >= 0
                 && score.missedGroups >= 0
                 && score.timingMistakes >= 0
                 && score.timingMistakes <= score.wrongGroups
                 && score.totalCorrectGroups
                    + score.wrongGroups
                    + score.missedGroups
                    == score.totalGroups;
        }

        function expectedNotationReadingLevel(score) {
          return score.beginnerCorrect >= 4
                 && score.intermediateCorrect >= 4
                 && score.advancedCorrect >= 4
                 ? 'advanced'
                 : score.beginnerCorrect >= 4
                   && score.intermediateCorrect >= 4
                   ? 'intermediate'
                   : 'beginner';
        }

        function passedPianoTier(correctGroups, totalGroups) {
          return correctGroups * 100 >= totalGroups * 70;
        }

        function expectedPianoExecutionLevel(score) {
          return passedPianoTier(
                   score.beginnerCorrectGroups,
                   score.beginnerTotalGroups
                 )
                 && passedPianoTier(
                   score.intermediateCorrectGroups,
                   score.intermediateTotalGroups
                 )
                 && passedPianoTier(
                   score.advancedCorrectGroups,
                   score.advancedTotalGroups
                 )
                 ? 'advanced'
                 : passedPianoTier(
                     score.beginnerCorrectGroups,
                     score.beginnerTotalGroups
                   )
                   && passedPianoTier(
                     score.intermediateCorrectGroups,
                     score.intermediateTotalGroups
                   )
                   ? 'intermediate'
                   : 'beginner';
        }

        function expectedFinalSkillLevel(notationLevel, pianoLevel) {
          return notationLevel == 'beginner' || pianoLevel == 'beginner'
                 ? 'beginner'
                 : notationLevel == 'intermediate'
                   || pianoLevel == 'intermediate'
                   ? 'intermediate'
                   : 'advanced';
        }

        function validPlacementLevels(notationScore, pianoScore, data) {
          return data.notationReadingLevel
                    == expectedNotationReadingLevel(notationScore)
                 && data.pianoExecutionLevel
                    == expectedPianoExecutionLevel(pianoScore)
                 && data.finalSkillLevel
                    == expectedFinalSkillLevel(
                         data.notationReadingLevel,
                         data.pianoExecutionLevel
                       );
        }

        allow read: if ownsCurrentAssessment();

        allow create: if ownsCurrentAssessment()
                      && request.resource.data.keys().hasOnly([
                           'userId',
                           'status',
                           'currentSection',
                           'assessmentVersion',
                           'startedAt',
                           'expiresAt',
                           'completedAt',
                           'serverCheckedAt',
                           'createdAt',
                           'updatedAt'
                         ])
                      && request.resource.data.userId == userId
                      && request.resource.data.status == 'inProgress'
                      && request.resource.data.currentSection
                         == 'introduction'
                      && request.resource.data.assessmentVersion == 1
                      && request.resource.data.startedAt == request.time
                      && request.resource.data.expiresAt == null
                      && request.resource.data.completedAt == null
                      && request.resource.data.serverCheckedAt == request.time
                      && request.resource.data.createdAt == request.time
                      && request.resource.data.updatedAt == request.time;

        allow update: if ownsCurrentAssessment()
                      && (
                        (
                          resource.data.expiresAt == null
                          && request.resource.data.diff(resource.data)
                               .affectedKeys()
                               .hasOnly([
                                 'expiresAt',
                                 'updatedAt'
                               ])
                          && request.resource.data.expiresAt is timestamp
                          && request.resource.data.expiresAt
                             == resource.data.startedAt
                                + duration.value(3, 'd')
                          && request.resource.data.updatedAt == request.time
                        )
                        ||
                        (
                          request.resource.data.diff(resource.data)
                               .affectedKeys()
                               .hasOnly([
                                 'serverCheckedAt',
                                 'updatedAt'
                               ])
                          && resource.data.status == 'inProgress'
                          && request.resource.data.serverCheckedAt
                             == request.time
                          && request.resource.data.updatedAt == request.time
                        )
                        ||
                        (
                          resource.data.status == 'inProgress'
                          && resource.data.expiresAt is timestamp
                          && request.time < resource.data.expiresAt
                          && resource.data.currentSection == 'notationReading'
                          && request.resource.data.currentSection
                             == 'pianoExecution'
                          && request.resource.data.diff(resource.data)
                               .affectedKeys()
                               .hasOnly([
                                 'notationReadingAnswers',
                                 'notationReadingScore',
                                 'currentSection',
                                 'serverCheckedAt',
                                 'updatedAt'
                               ])
                          && validNotationReadingAnswers(
                               request.resource.data.notationReadingAnswers
                             )
                          && validNotationReadingScore(
                               request.resource.data.notationReadingAnswers,
                               request.resource.data.notationReadingScore
                             )
                          && request.resource.data.serverCheckedAt
                             == request.time
                          && request.resource.data.updatedAt == request.time
                        )
                        ||
                        (
                          resource.data.status == 'inProgress'
                          && resource.data.expiresAt is timestamp
                          && request.time < resource.data.expiresAt
                          && resource.data.currentSection == 'pianoExecution'
                          && request.resource.data.currentSection
                             == 'results'
                          && request.resource.data.status == 'completed'
                          && request.resource.data.diff(resource.data)
                               .affectedKeys()
                               .hasOnly([
                                 'pianoTaskResults',
                                 'pianoExecutionScore',
                                 'notationReadingLevel',
                                 'pianoExecutionLevel',
                                 'finalSkillLevel',
                                 'placementMethod',
                                 'status',
                                 'currentSection',
                                 'completedAt',
                                 'serverCheckedAt',
                                 'updatedAt'
                               ])
                          && validPianoExecutionScore(
                               request.resource.data.pianoTaskResults,
                               request.resource.data.pianoExecutionScore
                             )
                          && validPlacementLevels(
                               resource.data.notationReadingScore,
                               request.resource.data.pianoExecutionScore,
                               request.resource.data
                             )
                          && request.resource.data.placementMethod
                             == 'fullAssessment'
                          && request.resource.data.completedAt == request.time
                          && request.resource.data.serverCheckedAt
                             == request.time
                          && request.resource.data.updatedAt == request.time
                        )
                        ||
                        (
                          resource.data.status == 'inProgress'
                          && resource.data.expiresAt is timestamp
                          && request.time < resource.data.expiresAt
                          && resource.data.currentSection == 'questionnaire'
                          && request.resource.data.currentSection == 'results'
                          && request.resource.data.status == 'completed'
                          && request.resource.data.diff(resource.data)
                               .affectedKeys()
                               .hasOnly([
                                 'questionnaireAnswers',
                                 'placementMethod',
                                 'finalSkillLevel',
                                 'status',
                                 'currentSection',
                                 'completedAt',
                                 'serverCheckedAt',
                                 'updatedAt'
                               ])
                          && validQuestionnaireAnswers(
                               request.resource.data.questionnaireAnswers
                             )
                          && isSelfReportedBeginner(
                               request.resource.data.questionnaireAnswers
                             )
                          && request.resource.data.placementMethod
                             == 'selfReportedBeginner'
                          && request.resource.data.finalSkillLevel
                             == 'beginner'
                          && request.resource.data.completedAt == request.time
                          && request.resource.data.serverCheckedAt
                             == request.time
                          && request.resource.data.updatedAt == request.time
                        )
                        ||
                        (
                          resource.data.status == 'inProgress'
                          && resource.data.expiresAt is timestamp
                          && request.time < resource.data.expiresAt
                          && request.resource.data.diff(resource.data)
                               .affectedKeys()
                               .hasOnly([
                                 'currentSection',
                                 'serverCheckedAt',
                                 'updatedAt'
                               ])
                          && request.resource.data.serverCheckedAt
                             == request.time
                          && request.resource.data.updatedAt == request.time
                          && resource.data.currentSection == 'introduction'
                          && request.resource.data.currentSection
                             == 'questionnaire'
                        )
                        ||
                        (
                          resource.data.status == 'inProgress'
                          && resource.data.expiresAt is timestamp
                          && request.time < resource.data.expiresAt
                          && resource.data.currentSection == 'questionnaire'
                          && request.resource.data.currentSection
                             == 'notationReading'
                          && request.resource.data.diff(resource.data)
                               .affectedKeys()
                               .hasOnly([
                                 'questionnaireAnswers',
                                 'currentSection',
                                 'serverCheckedAt',
                                 'updatedAt'
                               ])
                          && validQuestionnaireAnswers(
                               request.resource.data.questionnaireAnswers
                             )
                          && !isSelfReportedBeginner(
                               request.resource.data.questionnaireAnswers
                             )
                          && request.resource.data.serverCheckedAt
                             == request.time
                          && request.resource.data.updatedAt == request.time
                        )
                        ||
                        (
                          resource.data.status == 'inProgress'
                          && resource.data.expiresAt is timestamp
                          && request.time >= resource.data.expiresAt
                          && request.resource.data.diff(resource.data)
                               .affectedKeys()
                               .hasOnly([
                                 'status',
                                 'updatedAt'
                               ])
                          && request.resource.data.status == 'expired'
                          && request.resource.data.updatedAt == request.time
                          && getAfter(
                               /databases/$(database)/documents/users/$(userId)
                             ).data.skillLevel == expectedExpiredSkillLevel()
                          && getAfter(
                               /databases/$(database)/documents/users/$(userId)
                             ).data.updatedAt == request.time
                        )
                      );

        allow delete: if false;
      }

      match /challenge_progress/{challengeItemId} {
        allow read: if isVerifiedUser()
                    && request.auth.uid == userId;

        allow create: if isVerifiedUser()
                      && request.auth.uid == userId
                      && exists(
                           /databases/$(database)/documents/challenge_items/$(challengeItemId)
                         )
                      && request.resource.data.keys().hasOnly([
                           'challengeItemId',
                           'completed',
                           'mode',
                           'correctCount',
                           'wrongCount',
                           'missedCount',
                           'totalCount',
                           'xpAwarded',
                           'completedAt'
                         ])
                      && request.resource.data.challengeItemId
                         == challengeItemId
                      && request.resource.data.completed == true
                      && request.resource.data.mode == 'performance'
                      && request.resource.data.correctCount is int
                      && request.resource.data.wrongCount is int
                      && request.resource.data.missedCount is int
                      && request.resource.data.totalCount is int
                      && request.resource.data.xpAwarded is int
                      && request.resource.data.totalCount > 0
                      && request.resource.data.correctCount
                         == request.resource.data.totalCount
                      && request.resource.data.wrongCount == 0
                      && request.resource.data.missedCount == 0
                      && request.resource.data.xpAwarded == 20
                      && request.resource.data.completedAt == request.time;

        allow update, delete: if false;
      }

      match /practice_results/{resultId} {
        function ownsPracticeResult() {
          return isVerifiedUser()
                 && request.auth.uid == userId;
        }

        function validPracticeResult(data) {
          return data.keys().hasOnly([
                   'schemaVersion',
                   'practiceType',
                   'ownerId',
                   'scoreDocumentPath',
                   'source',
                   'pieceTitle',
                   'mode',
                   'completedAt',
                   'targetDurationMs',
                   'elapsedDurationMs',
                   'correctCount',
                   'wrongCount',
                   'missedCount',
                   'totalCount',
                   'timingAccuracyPercentage',
                   'noteBreakdown',
                   'clefBreakdown',
                   'suggestions',
                   'errorEventCount',
                   'storageStatus'
                 ])
                 && data.schemaVersion in [1, 2]
                 && (data.schemaVersion == 1
                     || data.practiceType in [
                          'sightReading',
                          'synthesia',
                          'arPerformance'
                        ])
                 && data.ownerId == userId
                 && data.scoreDocumentPath is string
                 && data.source in [
                      'composition', 'musicSheet', 'musicLibrary',
                      'challenge', 'lesson'
                    ]
                 && data.pieceTitle is string
                 && data.pieceTitle.size() > 0
                 && data.pieceTitle.size() <= 200
                 && data.mode == 'performance'
                 && data.completedAt is timestamp
                 && data.targetDurationMs is int
                 && data.targetDurationMs >= 0
                 && data.elapsedDurationMs is int
                 && data.elapsedDurationMs >= 0
                 && data.correctCount is int
                 && data.correctCount >= 0
                 && data.wrongCount is int
                 && data.wrongCount >= 0
                 && data.missedCount is int
                 && data.missedCount >= 0
                 && data.totalCount is int
                 && data.totalCount > 0
                 && data.correctCount
                    + data.wrongCount
                    + data.missedCount == data.totalCount
                 && data.timingAccuracyPercentage is int
                 && data.timingAccuracyPercentage >= 0
                 && data.timingAccuracyPercentage <= 100
                 && data.noteBreakdown is list
                 && data.clefBreakdown is list
                 && data.suggestions is list
                 && data.suggestions.size() <= 3
                 && data.errorEventCount is int
                 && data.errorEventCount >= 0
                 && data.storageStatus in ['saving', 'complete'];
        }

        allow read, delete: if ownsPracticeResult();

        allow create: if ownsPracticeResult()
                      && validPracticeResult(request.resource.data)
                      && request.resource.data.completedAt == request.time
                      && request.resource.data.storageStatus == 'saving';

        allow update: if ownsPracticeResult()
                      && validPracticeResult(request.resource.data)
                      && request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly(['storageStatus'])
                      && resource.data.storageStatus == 'saving'
                      && request.resource.data.storageStatus == 'complete';

        match /error_events/{eventId} {
          function ownsPracticeErrorEvent() {
            return isVerifiedUser()
                   && request.auth.uid == userId;
          }

          allow read, delete: if ownsPracticeErrorEvent();

          allow create: if ownsPracticeErrorEvent()
                        && request.resource.data.keys().hasOnly([
                             'positionIndex',
                             'measureNumber',
                             'scheduledTimeMs',
                             'expectedMidiNotes',
                             'playedMidiNotes',
                             'clefs',
                             'staffNumbers',
                             'issueTypes',
                             'timingOffsetMs',
                             'eventuallyMatched'
                           ])
                        && request.resource.data.positionIndex is int
                        && request.resource.data.positionIndex >= 0
                        && (
                          request.resource.data.measureNumber == null
                          || request.resource.data.measureNumber is string
                        )
                        && request.resource.data.scheduledTimeMs is int
                        && request.resource.data.scheduledTimeMs >= 0
                        && request.resource.data.expectedMidiNotes is list
                        && request.resource.data.playedMidiNotes is list
                        && request.resource.data.clefs is list
                        && request.resource.data.staffNumbers is list
                        && request.resource.data.issueTypes is list
                        && (
                          request.resource.data.timingOffsetMs == null
                          || request.resource.data.timingOffsetMs is int
                        )
                        && request.resource.data.eventuallyMatched is bool;

          allow update: if false;
        }
      }
    }

    match /challenge_levels/{levelId} {
      allow read: if isVerifiedUser() || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /challenge_items/{itemId} {
      allow read: if isVerifiedUser() || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /fundamentals_folders/{folderId} {
      allow read: if isVerifiedUser() || isAdmin();
      allow create, update, delete: if isAdmin();

      match /lessons/{lessonId} {
        allow read: if isVerifiedUser() || isAdmin();
        allow create, update, delete: if isAdmin();
      }
    }

    match /available_pieces/{pieceId} {
      allow read: if isVerifiedUser() || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /admins/{adminId} {
      allow get: if request.auth != null
                 && request.auth.uid == adminId;

      allow list, create, update, delete: if false;
    }

    match /users/{userId}/musicSheets/{sheetId} {
      function validImageSource(file, index) {
        let parts = file.storagePath.split('/');
        let pageNames = [
          'page_01', 'page_02', 'page_03', 'page_04', 'page_05',
          'page_06', 'page_07', 'page_08', 'page_09', 'page_10',
          'page_11', 'page_12', 'page_13', 'page_14', 'page_15',
          'page_16', 'page_17', 'page_18', 'page_19', 'page_20'
        ];
        return file is map
               && file.pageNumber == index + 1
               && file.storagePath is string
               && parts.size() == 4
               && parts[0] == 'musicSheets'
               && parts[1] == userId
               && parts[2] == sheetId
               && parts[3].matches(
                 pageNames[index] + '[.](jpg|jpeg|png|heic|webp)'
               );
      }

      function validImageSourceIfPresent(data, index) {
        return data.files.size() <= index
               || validImageSource(data.files[index], index);
      }

      function validSheetSourcePaths(data) {
        return (
          data.type == 'pdf'
          && data.files[0] is map
          && data.files[0].storagePath ==
             'musicSheets/' + userId + '/' + sheetId + '/sheet.pdf'
        ) || (
          data.type == 'images'
          && validImageSourceIfPresent(data, 0)
          && validImageSourceIfPresent(data, 1)
          && validImageSourceIfPresent(data, 2)
          && validImageSourceIfPresent(data, 3)
          && validImageSourceIfPresent(data, 4)
          && validImageSourceIfPresent(data, 5)
          && validImageSourceIfPresent(data, 6)
          && validImageSourceIfPresent(data, 7)
          && validImageSourceIfPresent(data, 8)
          && validImageSourceIfPresent(data, 9)
          && validImageSourceIfPresent(data, 10)
          && validImageSourceIfPresent(data, 11)
          && validImageSourceIfPresent(data, 12)
          && validImageSourceIfPresent(data, 13)
          && validImageSourceIfPresent(data, 14)
          && validImageSourceIfPresent(data, 15)
          && validImageSourceIfPresent(data, 16)
          && validImageSourceIfPresent(data, 17)
          && validImageSourceIfPresent(data, 18)
          && validImageSourceIfPresent(data, 19)
        ) || (
          data.type == 'audio'
          && data.files[0].storagePath ==
             'musicSheets/' + userId + '/' + sheetId + '/source.mp3'
        );
      }

      allow create: if isVerifiedUser()
                    && request.auth.uid == userId
                    && request.resource.data.ownerId == userId
                    && request.resource.data.keys().hasOnly([
                      'ownerId', 'title', 'type', 'pageCount', 'durationMs', 'files',
                      'createdAt', 'updatedAt'
                    ])
                    && validMusicSheet(request.resource.data)
                    && validSheetSourcePaths(request.resource.data);

      allow read: if isVerifiedUser()
                  && request.auth.uid == userId;

      allow delete: if isVerifiedUser()
                    && request.auth.uid == userId
                    && resource.data.ownerId == userId;

      allow update: if isVerifiedUser()
                    && request.auth.uid == userId
                    && resource.data.ownerId == userId
                    && request.resource.data.ownerId == userId
                    && request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly(['title', 'updatedAt'])
                    && validMusicSheet(request.resource.data);
    }

    match /users/{userId}/compositions/{compositionId} {
      function isCompositionContentUpdate() {
        return request.resource.data.diff(resource.data)
                 .affectedKeys()
                 .hasOnly([
                   'title',
                   'key',
                   'tempo',
                   'beatsPerMeasure',
                   'beatUnit',
                   'measureCount',
                   'notes',
                   'creationMethod',
                   'recordingSchemaVersion',
                   'performanceNotes',
                   'performanceDurationUs',
                   'generationStatus',
                   'updatedAt'
                 ])
               && request.resource.data.generationStatus == 'pending'
               && request.resource.data.updatedAt == request.time;
      }

      function isGenerationRetry() {
        return request.resource.data.diff(resource.data)
                 .affectedKeys()
                 .hasOnly(['generationStatus'])
               && request.resource.data.generationStatus == 'pending'
               && request.resource.data.updatedAt == resource.data.updatedAt;
      }

      function isGenerationFailure() {
        return request.resource.data.diff(resource.data)
                 .affectedKeys()
                 .hasOnly(['generationStatus'])
               && request.resource.data.generationStatus == 'failed'
               && request.resource.data.updatedAt == resource.data.updatedAt;
      }

      allow create: if isVerifiedUser()
                    && request.auth.uid == userId
                    && request.resource.data.ownerId == userId
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.generationStatus == 'pending'
                    && !request.resource.data.keys().hasAny([
                         'pdfStoragePath',
                         'musicXmlStoragePath',
                         'midiStoragePath',
                         'mp3StoragePath',
                         'generatedFilesVersion',
                         'filesGeneratedAt'
                       ])
                    && validComposition(request.resource.data);

      allow read: if isVerifiedUser()
                  && request.auth.uid == userId;

      allow delete: if isVerifiedUser()
                    && request.auth.uid == userId
                    && resource.data.ownerId == userId
                    && resource.data.ownerId == request.auth.uid;

      allow update: if isVerifiedUser()
                    && request.auth.uid == userId
                    && resource.data.ownerId == userId
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == userId
                    && request.resource.data.ownerId
                       == resource.data.ownerId
                    && request.resource.data.createdAt
                       == resource.data.createdAt
                    && (
                      !('creationMethod' in resource.data)
                      || request.resource.data.creationMethod
                         == resource.data.creationMethod
                    )
                    && (
                      isCompositionContentUpdate()
                      || isGenerationRetry()
                      || isGenerationFailure()
                    )
                    && validComposition(request.resource.data);
    }

    match /compositionPosts/{postId} {
      allow read: if isVerifiedUser() || isAdmin();

      allow create, update, delete: if false;

      match /versions/{versionId} {
        allow read: if isVerifiedUser() || isAdmin();

        allow create, update, delete: if false;

        match /likes/{userId} {
          allow read: if isVerifiedUser();

          allow create: if isVerifiedUser()
                        && request.auth.uid == userId
                        && request.resource.data.keys().hasOnly([
                             'userId',
                             'createdAt'
                           ])
                        && request.resource.data.userId == request.auth.uid
                        && request.resource.data.createdAt == request.time;

          allow update: if false;

          allow delete: if isVerifiedUser()
                        && request.auth.uid == userId;
        }

        match /comments/{commentId} {
          allow read: if isVerifiedUser();

          allow create: if isVerifiedUser()
                        && request.resource.data.keys().hasOnly([
                             'userId',
                             'username',
                             'profileImageUrl',
                             'text',
                             'createdAt'
                           ])
                        && request.resource.data.userId == request.auth.uid
                        && request.resource.data.username is string
                        && request.resource.data.profileImageUrl is string
                        && request.resource.data.text is string
                        && request.resource.data.text.size() > 0
                        && request.resource.data.text.size() <= 500
                        && request.resource.data.createdAt == request.time;

          allow update: if false;

          allow delete: if isVerifiedUser()
                        && (
                          request.auth.uid == resource.data.userId
                          || request.auth.uid == get(
                               /databases/$(database)/documents/compositionPosts/$(postId)
                             ).data.ownerId
                        );
        }
      }
    }

    match /savedCompositionPosts/{saveId} {
      allow get: if isVerifiedUser()
                 && saveId.matches(request.auth.uid + '_.*');

      allow list: if isVerifiedUser()
                  && resource.data.userId == request.auth.uid;

      allow create: if isVerifiedUser()
                    && request.resource.data.keys().hasOnly([
                         'userId',
                         'postId',
                         'versionNumber',
                         'savedAt'
                       ])
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.postId is string
                    && request.resource.data.versionNumber is int
                    && request.resource.data.versionNumber > 0
                    && request.resource.data.savedAt == request.time;

      allow update: if false;

      allow delete: if isVerifiedUser()
                    && resource.data.userId == request.auth.uid;
    }

  }
}
